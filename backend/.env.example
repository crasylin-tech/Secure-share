# Скопируйте этот файл в .env и заполните значения

# База данных PostgreSQL
# Для Railway: берётся из переменных окружения сервиса автоматически
# Для локальной разработки:
DATABASE_URL=postgresql://postgres:password@localhost:5432/secureshare

# JWT секретный ключ — замените на любую длинную случайную строку
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_minimum_32_chars

# Порт сервера
PORT=3000

# URL фронтенда для CORS (GitHub Pages URL или localhost для разработки)
FRONTEND_URL=http://localhost:5500
# FRONTEND_URL=https://your-username.github.io
